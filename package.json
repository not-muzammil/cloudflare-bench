{
  "name": "cloudflare-bench",
  "version": "0.2.0",
  "description": "Benchmark, analyze, and optimize any app, framework, or API for Cloudflare's 10ms CPU Free Tier limit.",
  "type": "module",
  "bin": {
    "cf-bench": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "cloudflare-workers",
    "cpu",
    "benchmark",
    "performance",
    "free-tier",
    "optimization",
    "ast-scanner",
    "edge",
    "astro",
    "nextjs",
    "hono"
  ],
  "author": "Muzammil",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.26.9",
    "@babel/traverse": "^7.26.9",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "glob": "^11.0.1",
    "ora": "^8.2.0",
    "table": "^6.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.13.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7",
    "wrangler": "^3.111.0"
  }
}
